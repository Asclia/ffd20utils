{
  "name": "ffd20utils",
  "version": "2.9.0",
  "description": "Compendium — criador de monstros, NPCs e masmorras para Final Fantasy d20 (FFd20) e Pathfinder 1e.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "app": "electron .",
    "start": "node server.js --open",
    "serve": "node server.js",
    "test": "node test/engine.test.mjs && node test/library.test.mjs && node test/dungeon.test.mjs && node test/autobuild.test.mjs && node test/classfx.test.mjs && node test/koofr.test.mjs",
    "build-data": "python3 tools/build_data.py",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "android:prepare": "npx cap add android && npx capacitor-assets generate --android --iconBackgroundColor \"#12101a\" --iconBackgroundColorDark \"#12101a\" && npx cap sync android"
  },
  "main": "desktop/main.js",
  "author": {
    "name": "Compendium"
  },
  "homepage": "https://github.com/Asclia/ffd20utils",
  "build": {
    "appId": "com.ffd20utils.app",
    "productName": "Compendium",
    "executableName": "compendium",
    "artifactName": "Compendium-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "desktop/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "Compendium-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Compendium",
      "artifactName": "Compendium-${version}-instalador.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "desktop/icon.png",
      "category": "Game",
      "synopsis": "Criador de monstros, NPCs e masmorras para FFd20 e Pathfinder",
      "maintainer": "Compendium <ffd20utils@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/android": "^6.2.3",
    "@capacitor/assets": "^3.0.5"
  }
}
